<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Strategy documents for the BYTEX trading engine: the file format that describes a strategy as data.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bytex.Core\Bytex.Core.csproj" />
    <ProjectReference Include="..\Bytex.Indicators\Bytex.Indicators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Examples\*.json" LogicalName="Bytex.Documents.Examples.%(Filename)%(Extension)" />
    <None Include="Examples\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
