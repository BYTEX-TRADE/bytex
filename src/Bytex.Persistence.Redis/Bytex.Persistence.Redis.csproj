<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Redis-backed state persistence for the BYTEX trading engine.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bytex.Core\Bytex.Core.csproj" />
    <ProjectReference Include="..\Bytex.Data\Bytex.Data.csproj" />
  </ItemGroup>

  <!--
    The key layout, the indexes and the rebuilding of orders are shared with every other backing store, as SOURCE
    rather than as a library: the types are internal, so a public one of the same name cannot collide in two
    assemblies, and a deployment that wants nothing to do with Redis does not acquire its client to get them.
  -->
  <ItemGroup>
    <Compile Include="..\Bytex.Persistence.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bytex.Live.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
